import os
import getpass
import urllib.parse

import pandas as pd
import numpy as np
import matplotlib
matplotlib.use("Agg")  # lets the script save a picture without opening a window
import matplotlib.pyplot as plt
from sqlalchemy import create_engine

# ==========================================
# 1. DATABASE CONNECTION
# ==========================================
raw_password = input("Enter DB password: ")
encoded_password = urllib.parse.quote_plus(raw_password)
engine = create_engine(
    f"postgresql+psycopg2://postgres:{encoded_password}@localhost:5432/ecommerce_analytics"
)

print("Reading transactions...")
df = pd.read_sql("SELECT customer_unique_id, order_id, order_date FROM v_customer_transactions", engine)
df["order_date"] = pd.to_datetime(df["order_date"])
print(f"Loaded {len(df):,} orders.\n")

# ==========================================
# 2. COHORTS: group customers by the month of their FIRST order
# ==========================================
df["order_month"] = df["order_date"].dt.to_period("M")
df["cohort_month"] = df.groupby("customer_unique_id")["order_month"].transform("min")

# How many months after the first order did this order happen? (0 = first month)
df["months_since_first"] = (df["order_month"] - df["cohort_month"]).apply(lambda x: x.n)

# ==========================================
# 3. RETENTION TABLE
# ==========================================
counts = (
    df.groupby(["cohort_month", "months_since_first"])["customer_unique_id"]
    .nunique()
    .unstack(fill_value=0)
)
cohort_size = counts[0]
retention = counts.divide(cohort_size, axis=0) * 100

# Only keep cohorts with at least 100 customers (tiny early cohorts are noisy)
retention = retention[cohort_size >= 100]
cohort_size = cohort_size[cohort_size >= 100]

# Blank out months that have not happened yet for the newest cohorts
last_month = df["order_month"].max()
for cohort in retention.index:
    max_age = (last_month - cohort).n
    retention.loc[cohort, retention.columns > max_age] = np.nan

# ==========================================
# 4. KEY NUMBERS
# ==========================================
repeat_customers = (df.groupby("customer_unique_id")["order_id"].nunique() > 1).mean() * 100
month1 = retention[1].mean() if 1 in retention.columns else float("nan")
month3 = retention[3].mean() if 3 in retention.columns else float("nan")
month6 = retention[6].mean() if 6 in retention.columns else float("nan")

print("============ RETENTION SUMMARY ============")
print(f"Customers who ordered more than once: {repeat_customers:.1f}%")
print(f"Average retention after 1 month:      {month1:.2f}%")
print(f"Average retention after 3 months:     {month3:.2f}%")
print(f"Average retention after 6 months:     {month6:.2f}%")
print("===========================================\n")

# ==========================================
# 5. SAVE TABLE TO POSTGRESQL
# ==========================================
out = retention.round(2).reset_index()
out["cohort_month"] = out["cohort_month"].astype(str)
out.columns = [str(c) if c == "cohort_month" else f"month_{c}" for c in out.columns]
out.insert(1, "cohort_size", cohort_size.values)
out.to_sql("cohort_retention", engine, if_exists="replace", index=False)
print("Saved table 'cohort_retention' to PostgreSQL.")

# ==========================================
# 6. SAVE HEATMAP PICTURE
# ==========================================
show = retention.iloc[:, :13]  # first 12 months after the first order
fig, ax = plt.subplots(figsize=(11, 6))
im = ax.imshow(show.values, cmap="Blues", aspect="auto", vmin=0, vmax=max(1.0, np.nanmax(show.values[:, 1:]) if show.shape[1] > 1 else 1.0))
ax.set_xticks(range(show.shape[1]))
ax.set_xticklabels(show.columns)
ax.set_yticks(range(len(show.index)))
ax.set_yticklabels([f"{c} (n={cohort_size[c]:,})" for c in show.index], fontsize=8)
ax.set_xlabel("Months since first order")
ax.set_ylabel("First-order month (cohort)")
ax.set_title("Customer Retention by Cohort (% who ordered again)")
for i in range(show.shape[0]):
    for j in range(1, show.shape[1]):
        v = show.values[i, j]
        if not np.isnan(v):
            ax.text(j, i, f"{v:.1f}", ha="center", va="center", fontsize=7)
fig.colorbar(im, ax=ax, label="% of cohort (month 0 = 100%, not shaded)")
plt.tight_layout()

folder = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "dashboard")
os.makedirs(folder, exist_ok=True)
path = os.path.join(folder, "cohort_retention.png")
plt.savefig(path, dpi=150)
print(f"Saved chart: {os.path.normpath(path)}")